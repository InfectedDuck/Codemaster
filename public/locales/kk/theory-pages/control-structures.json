        "<code>or</code> - \u0415\u04a3 \u043a\u0435\u043c\u0456\u043d\u0434\u0435 \u0431\u0456\u0440 \u0448\u0430\u0440\u0442 \u0430\u049b\u0438\u049b\u0430\u0442 \u0431\u043e\u043b\u0443\u044b \u043a\u0435\u0440\u0435\u043a",
