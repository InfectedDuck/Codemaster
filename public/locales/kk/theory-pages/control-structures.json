        "<code>elif</code> \u043a\u0456\u043b\u0442 \u0441\u04e9\u0437\u0456 \u2014 \"else if\" \u049b\u044b\u0441\u049b\u0430\u0440\u0442\u044b\u043b\u0493\u0430\u043d \u0442\u04af\u0440\u0456",
        "\u0411\u0456\u0440\u043d\u0435\u0448\u0435 <code>elif</code> \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u0443\u0493\u0430 \u0431\u043e\u043b\u0430\u0434\u044b",
        "<code>else</code> \u0442\u0430\u0440\u043c\u0430\u0493\u044b \u043c\u0456\u043d\u0434\u0435\u0442\u0442\u0456 \u0435\u043c\u0435\u0441 \u0436\u04d9\u043d\u0435 \u0431\u0430\u0440\u043b\u044b\u049b \u049b\u0430\u043b\u0493\u0430\u043d \u0436\u0430\u0493\u0434\u0430\u0439\u043b\u0430\u0440\u0434\u044b \u04b1\u0441\u0442\u0430\u0439\u0434\u044b"
