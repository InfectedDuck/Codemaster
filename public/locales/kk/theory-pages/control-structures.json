  "sections": {
    "introduction": {
      "navTitle": "\u041a\u0456\u0440\u0456\u0441\u043f\u0435",
      "title": "\u0411\u0430\u0441\u049b\u0430\u0440\u0443 \u049b\u04b1\u0440\u044b\u043b\u044b\u043c\u0434\u0430\u0440\u044b\u043d\u0430 \u043a\u0456\u0440\u0456\u0441\u043f\u0435",
      "paragraph1": "\u0411\u0430\u0441\u049b\u0430\u0440\u0443 \u049b\u04b1\u0440\u044b\u043b\u044b\u043c\u0434\u0430\u0440\u044b \u2014 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043b\u0430\u0443 \u043b\u043e\u0433\u0438\u043a\u0430\u0441\u044b\u043d\u044b\u04a3 \u043d\u0435\u0433\u0456\u0437\u0456. \u041e\u043b\u0430\u0440 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u04a3\u044b\u0437\u0434\u044b\u04a3 \u0430\u0493\u044b\u043d\u044b\u043d \u0431\u0430\u0441\u049b\u0430\u0440\u0443\u0493\u0430, \u0448\u0430\u0440\u0442\u0442\u0430\u0440\u0493\u0430 \u043d\u0435\u0433\u0456\u0437\u0434\u0435\u043b\u0433\u0435\u043d \u0448\u0435\u0448\u0456\u043c\u0434\u0435\u0440 \u049b\u0430\u0431\u044b\u043b\u0434\u0430\u0443\u0493\u0430 \u0436\u04d9\u043d\u0435 \u04d9\u0440\u0435\u043a\u0435\u0442\u0442\u0435\u0440\u0434\u0456 \u0442\u0438\u0456\u043c\u0434\u0456 \u049b\u0430\u0439\u0442\u0430\u043b\u0430\u0443\u0493\u0430 \u043c\u04af\u043c\u043a\u0456\u043d\u0434\u0456\u043a \u0431\u0435\u0440\u0435\u0434\u0456.",
      "callout": "<strong>\u0421\u0456\u0437 \u043d\u0435 \u04af\u0439\u0440\u0435\u043d\u0435\u0441\u0456\u0437:</strong> \u0428\u0435\u0448\u0456\u043c \u049b\u0430\u0431\u044b\u043b\u0434\u0430\u0443 \u04af\u0448\u0456\u043d if/elif/else \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043b\u0430\u0440\u044b\u043d, \u049b\u0430\u0439\u0442\u0430\u043b\u0430\u0443 \u04af\u0448\u0456\u043d for \u0436\u04d9\u043d\u0435 while \u0446\u0438\u043a\u043b\u0434\u0435\u0440\u0456\u043d, break \u0436\u04d9\u043d\u0435 continue \u0430\u0440\u049b\u044b\u043b\u044b \u0446\u0438\u043a\u043b\u0434\u0435\u0440\u0434\u0456 \u0431\u0430\u0441\u049b\u0430\u0440\u0443\u0434\u044b \u0436\u04d9\u043d\u0435 \u0431\u04b1\u043b \u049b\u04b1\u0440\u044b\u043b\u044b\u043c\u0434\u0430\u0440\u0434\u044b \u0442\u0438\u0456\u043c\u0434\u0456 \u04af\u0439\u043b\u0435\u0441\u0442\u0456\u0440\u0443\u0434\u0456 \u043c\u0435\u04a3\u0433\u0435\u0440\u0435\u0441\u0456\u0437.",
      "typesTitle": "\u0411\u0430\u0441\u049b\u0430\u0440\u0443 \u049b\u04b1\u0440\u044b\u043b\u044b\u043c\u0434\u0430\u0440\u044b\u043d\u044b\u04a3 \u0442\u04af\u0440\u043b\u0435\u0440\u0456",
      "types": {
        "conditional": {
          "title": "\u0428\u0430\u0440\u0442\u0442\u044b",
          "description": "if, elif \u0436\u04d9\u043d\u0435 else \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043b\u0430\u0440\u044b\u043c\u0435\u043d \u0448\u0435\u0448\u0456\u043c \u049b\u0430\u0431\u044b\u043b\u0434\u0430\u0443"
        },
        "iterative": {
          "title": "\u049a\u0430\u0439\u0442\u0430\u043b\u0430\u043d\u0430\u0442\u044b\u043d",
          "description": "for \u0436\u04d9\u043d\u0435 while \u0446\u0438\u043a\u043b\u0434\u0435\u0440\u0456\u043c\u0435\u043d \u04d9\u0440\u0435\u043a\u0435\u0442\u0442\u0435\u0440\u0434\u0456 \u049b\u0430\u0439\u0442\u0430\u043b\u0430\u0443"
        },
        "controlFlow": {
          "title": "\u0410\u0493\u044b\u043d\u0434\u044b \u0431\u0430\u0441\u049b\u0430\u0440\u0443",
          "description": "break \u0436\u04d9\u043d\u0435 continue \u0430\u0440\u049b\u044b\u043b\u044b \u0446\u0438\u043a\u043b \u04d9\u0440\u0435\u043a\u0435\u0442\u0456\u043d \u04e9\u0437\u0433\u0435\u0440\u0442\u0443"
        }
      },
      "whyTitle": "\u0411\u0430\u0441\u049b\u0430\u0440\u0443 \u049b\u04b1\u0440\u044b\u043b\u044b\u043c\u0434\u0430\u0440\u044b \u043d\u0435\u043b\u0456\u043a\u0442\u0435\u043d \u043c\u0430\u04a3\u044b\u0437\u0434\u044b",
      "whyReasons": [
        "\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043b\u0430\u0440\u0493\u0430 \u0430\u049b\u044b\u043b\u0434\u044b \u0448\u0435\u0448\u0456\u043c\u0434\u0435\u0440 \u049b\u0430\u0431\u044b\u043b\u0434\u0430\u0443\u0493\u0430 \u043c\u04af\u043c\u043a\u0456\u043d\u0434\u0456\u043a \u0431\u0435\u0440\u0435\u0434\u0456",
        "\u049a\u0430\u0439\u0442\u0430\u043b\u0430\u043d\u0430\u0442\u044b\u043d \u0442\u0430\u043f\u0441\u044b\u0440\u043c\u0430\u043b\u0430\u0440\u0434\u044b \u0442\u0438\u0456\u043c\u0434\u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0442\u0430\u043d\u0434\u044b\u0440\u0430\u0434\u044b",
        "\u04d8\u0440\u0442\u04af\u0440\u043b\u0456 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439\u043b\u0435\u0440 \u043c\u0435\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u0443\u0448\u044b \u0435\u043d\u0433\u0456\u0437\u0443\u043b\u0435\u0440\u0456\u043d \u04e9\u04a3\u0434\u0435\u0439\u0434\u0456",
        "\u0414\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u043b\u044b\u049b \u0436\u04d9\u043d\u0435 \u0438\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u0442\u0456 \u049b\u043e\u0441\u044b\u043c\u0448\u0430\u043b\u0430\u0440 \u049b\u04b1\u0440\u0443\u0493\u0430 \u043c\u04af\u043c\u043a\u0456\u043d\u0434\u0456\u043a \u0431\u0435\u0440\u0435\u0434\u0456"
      ]
    },
    "ifStatements": {
      "navTitle": "If \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043b\u0430\u0440\u044b",
      "title": "If \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043b\u0430\u0440\u044b",
      "paragraph1": "If \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043b\u0430\u0440\u044b \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u04a3\u044b\u0437\u0493\u0430 \u0448\u0430\u0440\u0442\u0442\u0430\u0440\u0434\u044b\u04a3 \u0430\u049b\u0438\u049b\u0430\u0442 \u043d\u0435\u043c\u0435\u0441\u0435 \u0436\u0430\u043b\u0493\u0430\u043d \u0435\u043a\u0435\u043d\u0434\u0456\u0433\u0456\u043d\u0435 \u049b\u0430\u0440\u0430\u0439 \u04d9\u0440\u0442\u04af\u0440\u043b\u0456 \u043a\u043e\u0434 \u0431\u043b\u043e\u043a\u0442\u0430\u0440\u044b\u043d \u043e\u0440\u044b\u043d\u0434\u0430\u0443 \u0430\u0440\u049b\u044b\u043b\u044b \u0448\u0435\u0448\u0456\u043c \u049b\u0430\u0431\u044b\u043b\u0434\u0430\u0443\u0493\u0430 \u043c\u04af\u043c\u043a\u0456\u043d\u0434\u0456\u043a \u0431\u0435\u0440\u0435\u0434\u0456.",
      "structureTitle": "If \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b\u043d\u044b\u04a3 \u049b\u04b1\u0440\u044b\u043b\u044b\u043c\u044b",
      "structureItems": [
        "<code>if</code> \u043a\u0456\u043b\u0442 \u0441\u04e9\u0437\u0456\u043d\u0435\u043d \u0431\u0430\u0441\u0442\u0430\u043b\u0430\u0434\u044b",
