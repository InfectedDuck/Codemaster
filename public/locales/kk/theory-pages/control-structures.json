    "subtitle": "\u041d\u0435\u0433\u0456\u0437\u0433\u0456 \u0434\u0435\u04a3\u0433\u0435\u0439 \u2022 60 \u043c\u0438\u043d\u0443\u0442 \u2022 Python-\u0434\u0430 \u0448\u0435\u0448\u0456\u043c \u049b\u0430\u0431\u044b\u043b\u0434\u0430\u0443 \u043c\u0435\u043d \u049b\u0430\u0439\u0442\u0430\u043b\u0430\u0443\u0434\u044b \u043c\u0435\u04a3\u0433\u0435\u0440\u0443"
